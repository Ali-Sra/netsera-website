# Copy this file to .env.production and replace every placeholder.
# Never commit .env.production.

POSTGRES_DB=netsera
POSTGRES_USER=netsera_prod
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# Phase 9 local production-like test:
PUBLIC_ORIGIN=http://localhost:8088
HTTP_PORT=8088

# Initial admin bootstrap.
# Use a unique password with at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD
